<!-- rooms.ejs -->
<html lang="en">
<%- include('./partials/head') %>
<body>
  <%- include('./partials/nav') %>
  <div class="container mt-5">
    <h2 class="mb-4">Available Chat Rooms</h2>
    <ul class="list-group">
      <% rooms.forEach(room => { %>
        <li class="list-group-item">
          <a href="/chat?roomName=<%= room.name %>" class="text-decoration-none room-link">
            <%= room.name %>
          </a>
        </li>
      <% }); %>
    </ul>
  </div>
</body>
</html>